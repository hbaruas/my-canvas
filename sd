import pandas as pd

files = {
    "software_dev": "software_development.csv",
    "ml1": "ml1.csv",
    "ml2": "ml2.csv",
}

series_dict = {}

for name, path in files.items():
  # Read just the header first to inspect and normalize column names
  raw_cols = pd.read_csv(path, nrows=0).columns.tolist()
  clean_map = {col.strip().lower(): col for col in raw_cols}

  # Check if 'year' and 'soc4' (or common variants) exist
  year_col = clean_map.get("year")
  soc_col = (
      clean_map.get("soc4")
      or clean_map.get("soc_4")
      or clean_map.get("soc")
  )

  if not year_col or not soc_col:
    raise ValueError(
        f"Column mismatch in '{path}'. Found columns: {raw_cols}"
    )

  # Load using the exact original column names found in that specific file
  df = pd.read_csv(path, usecols=[year_col, soc_col]).dropna()
  df = df.rename(columns={year_col: "year", soc_col: "soc4"})

  df["year"] = df["year"].astype(int)
  df["soc4"] = df["soc4"].astype(int)

  counts = df.groupby(["year", "soc4"]).size()
  series_dict[name] = counts

  # OUTPUT 1: Individual pivoted CSV
  pivoted = counts.unstack(level="soc4", fill_value=0).astype(int)
  individual_csv = f"{name}_soc4_by_year.csv"
  pivoted.to_csv(individual_csv, index=True)
  print(
      f"Saved individual pivoted table -> {individual_csv} (matched columns:"
      f" '{year_col}', '{soc_col}')"
  )

# Align all 3 datasets on every (year, soc4) pair
comp = pd.DataFrame(series_dict).fillna(0).astype(int)
dataset_cols = list(files.keys())

# SINGLE OVERALL VERDICT
grand_totals = comp[dataset_cols].sum().sort_values(ascending=False)
ranked_names = grand_totals.index.tolist()

print("\n==================================================")
print("SINGLE OVERALL VERDICT (By Total Volume):")
print(
    f"  1st (Highest): {ranked_names[0]} ({grand_totals.iloc[0]:,} total jobs)"
)
print(
    f"  2nd (Middle) : {ranked_names[1]} ({grand_totals.iloc[1]:,} total jobs)"
)
print(
    f"  3rd (Lowest) : {ranked_names[2]} ({grand_totals.iloc[2]:,} total jobs)"
)
print(
    f"  Order        : {ranked_names[0]} > {ranked_names[1]} > {ranked_names[2]}"
)
print("==================================================\n")

# Cell-by-Cell Ranking
ranks = comp[dataset_cols].rank(axis=1, ascending=False, method="min")

comp["Highest"] = ranks.apply(
    lambda r: " / ".join(r.index[r == 1]), axis=1
)
comp["Middle"] = ranks.apply(
    lambda r: " / ".join(r.index[r == 2]) if (r == 2).any() else "Tie", axis=1
)
comp["Lowest"] = ranks.apply(
    lambda r: " / ".join(r.index[r == 3]) if (r == 3).any() else "Tie", axis=1
)

# OUTPUT 2: 3-way comparison CSV
comparison_csv = "soc4_three_way_comparison.csv"
comp.to_csv(comparison_csv)
print(f"Saved 3-way comparison table -> {comparison_csv}\n")

# Detailed Summary Table
summary = pd.DataFrame({
    "Grand_Total": comp[dataset_cols].sum(),
    "Share_of_Total (%)": (
        comp[dataset_cols].sum() / comp[dataset_cols].sum().sum() * 100
    ).round(2),
    "Mean_Per_Year_SOC": comp[dataset_cols].mean().round(2),
    "Avg_Cell_Rank (1=High, 3=Low)": ranks.mean().round(3),
    "Cells_Won (#1)": (ranks == 1).sum(),
    "Cells_Middle (#2)": (ranks == 2).sum(),
    "Cells_Lost (#3)": (ranks == 3).sum(),
}).sort_values(by="Grand_Total", ascending=False)

print("=== DETAILED METRICS BREAKDOWN ===")
print(summary.to_string())
